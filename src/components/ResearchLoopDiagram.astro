---
interface Props {
  steps: readonly string[];
  caption: string;
}

const { steps, caption } = Astro.props;
---

<figure class="research-loop-figure">
  <p class="research-loop-figure__label">Information–Decision Loop</p>
  <svg
    class="research-loop-figure__diagram"
    viewBox="0 0 360 350"
    role="img"
    aria-labelledby="research-loop-figure-title research-loop-figure-description"
  >
    <title id="research-loop-figure-title">Information–decision loop</title>
    <desc id="research-loop-figure-description">
      Information or belief informs a decision or strategy, which shapes system or population
      dynamics. Observations support inference and updating, leading to strategy revision that
      informs future decisions.
    </desc>
    <defs>
      <marker id="research-loop-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M 0 0 L 7 4 L 0 8 z" class="research-loop-figure__arrowhead" />
      </marker>
    </defs>

    <path
      class="research-loop-figure__path"
      d="M 165 58 L 112 106"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__path"
      d="M 106 120 H 253"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__path"
      d="M 260 127 V 198"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__path"
      d="M 246 217 L 192 272"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__path"
      d="M 164 278 L 112 218"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__feedback-path"
      d="M 83 202 C 48 181 48 139 84 122"
      marker-end="url(#research-loop-arrow)"
    />

    <g class="research-loop-figure__node" transform="translate(180 46)">
      <circle r="5" />
      <text y="-28" text-anchor="middle">Information</text>
      <text y="-12" text-anchor="middle">/ Belief</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(98 120)">
      <circle r="5" />
      <text y="-30" text-anchor="middle">Decision</text>
      <text y="-14" text-anchor="middle">/ Strategy</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(260 120)">
      <circle r="5" />
      <text y="-30" text-anchor="middle">System / Population</text>
      <text y="-14" text-anchor="middle">Dynamics</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(260 206)">
      <circle r="5" />
      <text y="30" text-anchor="middle">Observation</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(180 284)">
      <circle r="5" />
      <text y="30" text-anchor="middle">Inference</text>
      <text y="46" text-anchor="middle">/ Updating</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(98 206)">
      <circle r="5" />
      <text y="30" text-anchor="middle">Strategy</text>
      <text y="46" text-anchor="middle">Revision</text>
    </g>

    <text class="research-loop-figure__feedback-label" x="24" y="160">
      feeds future decisions
    </text>
  </svg>

  <ol class="research-loop-figure__mobile" aria-label="Information–decision loop">
    {steps.map((step, index) => (
      <li>
        <span>{step}</span>
        {index < steps.length - 1 && <span aria-hidden="true">↓</span>}
      </li>
    ))}
    <li class="research-loop-figure__mobile-feedback">
      <span aria-hidden="true">↺</span>
      <span>feeds future decisions</span>
    </li>
  </ol>

  <figcaption class="research-loop-figure__caption">{caption}</figcaption>
</figure>
