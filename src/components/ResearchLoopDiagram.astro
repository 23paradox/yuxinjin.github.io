---
interface Props {
  steps: readonly string[];
  caption: string;
}

const { steps, caption } = Astro.props;
---

<figure class="research-loop-figure">
  <p class="research-loop-figure__label">Information–Decision Loop</p>
  <svg
    class="research-loop-figure__diagram"
    viewBox="0 0 430 300"
    role="img"
    aria-labelledby="research-loop-figure-title research-loop-figure-description"
  >
    <title id="research-loop-figure-title">Information–decision loop</title>
    <desc id="research-loop-figure-description">
      Information or belief informs a decision or strategy, which shapes system or population
      dynamics. Observations support inference and updating, leading to strategy revision that
      informs future decisions.
    </desc>
    <defs>
      <marker id="research-loop-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M 0 0 L 7 4 L 0 8 z" class="research-loop-figure__arrowhead" />
      </marker>
      <marker id="research-loop-feedback-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M 0 0 L 7 4 L 0 8 z" class="research-loop-figure__feedback-arrowhead" />
      </marker>
    </defs>

    <path
      class="research-loop-figure__path"
      d="M 103 56 V 79"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__path"
      d="M 165 106 H 256"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__path"
      d="M 326 132 V 164"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__path"
      d="M 286 203 L 246 238"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__path"
      d="M 178 253 L 142 207"
      marker-end="url(#research-loop-arrow)"
    />
    <path
      class="research-loop-figure__feedback-path"
      d="M 103 174 V 137"
      marker-end="url(#research-loop-feedback-arrow)"
    />

    <g class="research-loop-figure__node" transform="translate(103 25)">
      <text y="0" text-anchor="middle">Information</text>
      <text y="18" text-anchor="middle">/ Belief</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(103 104)">
      <text y="0" text-anchor="middle">Decision</text>
      <text y="18" text-anchor="middle">/ Strategy</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(326 104)">
      <text y="0" text-anchor="middle">System / Population</text>
      <text y="18" text-anchor="middle">Dynamics</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(326 195)">
      <text y="0" text-anchor="middle">Observation</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(210 267)">
      <text y="0" text-anchor="middle">Inference</text>
      <text y="18" text-anchor="middle">/ Updating</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(103 195)">
      <text y="0" text-anchor="middle">Strategy</text>
      <text y="18" text-anchor="middle">Revision</text>
    </g>
  </svg>

  <ol class="research-loop-figure__mobile" aria-label="Information–decision loop">
    {steps.map((step, index) => (
      <li>
        <span>{step}</span>
        {index < steps.length - 1 && <span aria-hidden="true">↓</span>}
      </li>
    ))}
    <li class="research-loop-figure__mobile-feedback">
      <span aria-hidden="true">↺</span>
      <span>feeds future decisions</span>
    </li>
  </ol>

  <figcaption class="research-loop-figure__caption">{caption}</figcaption>
</figure>
