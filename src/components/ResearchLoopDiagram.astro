---
interface Props {
  steps: readonly string[];
}

const { steps } = Astro.props;
---

<figure class="research-loop-figure">
  <svg
    class="research-loop-figure__diagram"
    viewBox="0 0 1200 230"
    role="img"
    aria-labelledby="research-loop-figure-title research-loop-figure-description"
  >
    <title id="research-loop-figure-title">Information–decision loop</title>
    <desc id="research-loop-figure-description">
      Information or belief informs a decision or strategy, which shapes system or population
      dynamics. Observations support inference and updating, leading to strategy revision that
      informs future decisions.
    </desc>
    <defs>
      <marker id="research-loop-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M 0 0 L 7 4 L 0 8 z" class="research-loop-figure__arrowhead" />
      </marker>
    </defs>

    <path class="research-loop-figure__path" d="M 148 72 H 216" marker-end="url(#research-loop-arrow)" />
    <path class="research-loop-figure__path" d="M 333 72 H 401" marker-end="url(#research-loop-arrow)" />
    <path class="research-loop-figure__path" d="M 538 72 H 606" marker-end="url(#research-loop-arrow)" />
    <path class="research-loop-figure__path" d="M 703 72 H 771" marker-end="url(#research-loop-arrow)" />
    <path class="research-loop-figure__path" d="M 910 72 H 978" marker-end="url(#research-loop-arrow)" />
    <path
      class="research-loop-figure__feedback-path"
      d="M 1056 102 C 1042 186, 318 186, 286 111"
      marker-end="url(#research-loop-arrow)"
    />

    <g class="research-loop-figure__node" transform="translate(70 72)">
      <circle r="5" />
      <text y="-16" text-anchor="middle">Information</text>
      <text y="6" text-anchor="middle">/ Belief</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(286 72)">
      <circle r="5" />
      <text y="-16" text-anchor="middle">Decision</text>
      <text y="6" text-anchor="middle">/ Strategy</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(470 72)">
      <circle r="5" />
      <text y="-16" text-anchor="middle">System / Population</text>
      <text y="6" text-anchor="middle">Dynamics</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(634 72)">
      <circle r="5" />
      <text y="-5" text-anchor="middle">Observation</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(840 72)">
      <circle r="5" />
      <text y="-16" text-anchor="middle">Inference</text>
      <text y="6" text-anchor="middle">/ Updating</text>
    </g>
    <g class="research-loop-figure__node" transform="translate(1010 72)">
      <circle r="5" />
      <text y="-16" text-anchor="middle">Strategy</text>
      <text y="6" text-anchor="middle">Revision</text>
    </g>

    <text class="research-loop-figure__feedback-label" x="655" y="212" text-anchor="middle">
      informs future decision and strategy
    </text>
  </svg>

  <ol class="research-loop-figure__mobile" aria-label="Information–decision loop">
    {steps.map((step, index) => (
      <li>
        <span>{step}</span>
        {index < steps.length - 1 && <span aria-hidden="true">↓</span>}
      </li>
    ))}
    <li class="research-loop-figure__mobile-feedback">
      <span aria-hidden="true">↺</span>
      <span>informs future decision and strategy</span>
    </li>
  </ol>
</figure>
