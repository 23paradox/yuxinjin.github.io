---
import type { PublicationEntry } from "../lib/content";
import { publicationStatusLabel } from "../data/publication-status";

interface Props {
  items: readonly PublicationEntry[];
  headingLevel?: "h2" | "h3";
}

const { items, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<ol class="publication-list">
  {items.map((publication) => (
    <li class="publication-list__item">
      <article>
        <Heading>{publication.data.title}</Heading>
        <p class="publication-list__authors">{publication.data.authors.join(", ")}</p>
        {(publication.data.venue || publication.data.status || publication.data.year) && (
          <p class="publication-list__meta">
            {[
              publication.data.venue,
              publication.data.status
                ? publicationStatusLabel(publication.data.status)
                : undefined,
              publication.data.acceptance
                ? `Accepted: ${publication.data.acceptance}`
                : undefined,
              publication.data.year,
            ]
              .filter(Boolean)
              .join(" · ")}
          </p>
        )}
        {publication.data.researchSummary && (
          <p>{publication.data.researchSummary}</p>
        )}
        {publication.data.links && publication.data.links.length > 0 && (
          <ul class="inline-links" aria-label={`Links for ${publication.data.title}`}>
            {publication.data.links.map((link) => (
              <li>
                <a href={link.url}>{link.label ?? link.purpose}</a>
              </li>
            ))}
          </ul>
        )}
      </article>
    </li>
  ))}
</ol>
