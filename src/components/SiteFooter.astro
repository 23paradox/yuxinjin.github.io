---
import { siteData } from "../data/site";
---

<footer class="site-footer">
  <div class="site-shell">
    <p class="site-footer__identity">{siteData.profile.researchIdentity}</p>
    {
      siteData.profile.email && (
        <p class="site-footer__email">
          <a href={`mailto:${siteData.profile.email}`}>{siteData.profile.email}</a>
        </p>
      )
    }
    <nav class="site-footer__links" aria-label="External profiles">
      {siteData.profile.googleScholarUrl && (
        <a href={siteData.profile.googleScholarUrl}>Google Scholar</a>
      )}
      {siteData.profile.googleScholarUrl && siteData.profile.researchGateUrl && (
        <span aria-hidden="true">·</span>
      )}
      {siteData.profile.researchGateUrl && (
        <a href={siteData.profile.researchGateUrl}>ResearchGate</a>
      )}
    </nav>
  </div>
</footer>
