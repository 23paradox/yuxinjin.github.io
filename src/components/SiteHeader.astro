---
import { Image } from "astro:assets";
import { placeholders } from "../data/placeholders";
import { siteData } from "../data/site";
import { withBase } from "../lib/paths";
import { showDevelopmentPlaceholders } from "../lib/rendering";

const homeHref = withBase("/");
const currentPath = Astro.url.pathname;
const isHomepage = currentPath === homeHref;
const headerClass = isHomepage
  ? "site-shell site-header__inner site-header__inner--home"
  : "site-shell site-header__inner";
const displayName = siteData.profile.name ?? (showDevelopmentPlaceholders ? placeholders.name : null);
const mastheadPhoto = siteData.about.photography.find(
  (photo) => photo.headerMasthead,
);

if (isHomepage && !mastheadPhoto) {
  throw new Error("Homepage header masthead photo is not configured.");
}
---

<header class:list={["site-header", isHomepage && "site-header--home-masthead"]}>
  {isHomepage && mastheadPhoto && (
    <Image
      class="site-header__masthead-image"
      src={mastheadPhoto.src}
      alt={mastheadPhoto.alt}
      widths={[480, 768, 1024, 1440, 1920]}
      sizes="100vw"
      format="webp"
      quality={85}
      priority
    />
  )}
  <div class={headerClass}>
    {!isHomepage && displayName && (
      <a class="site-identity" href={homeHref}>
        <span>{displayName}</span>
      </a>
    )}

    <nav aria-label="Primary navigation">
      <ul>
        {
          siteData.navigation.map((item) => {
            const href = withBase(item.href);
            const isCurrent = currentPath === href;

            return (
              <li>
                <a href={href} aria-current={isCurrent ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
        {
          siteData.profile.cvPath && (
            <li>
              <a href={withBase(siteData.profile.cvPath)}>CV</a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>
