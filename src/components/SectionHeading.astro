---
interface Props {
  title: string;
  description?: string;
  id?: string;
  level?: "h2" | "h3";
}

const { title, description, id, level = "h2" } = Astro.props;
const Heading = level;
---

<header class="section-heading">
  <Heading id={id}>{title}</Heading>
  {description && <p>{description}</p>}
</header>

