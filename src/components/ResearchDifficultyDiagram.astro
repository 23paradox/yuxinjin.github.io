---
type DiagramType = "heterogeneous" | "observations" | "strategic-beliefs";

interface Props {
  type: DiagramType;
}

const { type } = Astro.props;
---

{type === "heterogeneous" && (
  <figure class="research-difficulty-diagram">
    <svg
      viewBox="0 0 480 230"
      role="img"
      aria-labelledby="heterogeneous-information-title heterogeneous-information-description"
    >
      <title id="heterogeneous-information-title">Heterogeneous information</title>
      <desc id="heterogeneous-information-description">
        Three agents hold different beliefs and produce different responses. Their responses jointly
        shape population dynamics.
      </desc>
      <defs>
        <marker id="heterogeneous-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
          <path d="M 0 0 L 7 4 L 0 8 z" class="research-difficulty-diagram__arrowhead" />
        </marker>
      </defs>
      <text class="research-difficulty-diagram__label" x="90" y="28" text-anchor="middle">Agent A</text>
      <text class="research-difficulty-diagram__note" x="90" y="48" text-anchor="middle">Belief A</text>
      <text class="research-difficulty-diagram__label" x="240" y="28" text-anchor="middle">Agent B</text>
      <text class="research-difficulty-diagram__note" x="240" y="48" text-anchor="middle">Belief B</text>
      <text class="research-difficulty-diagram__label" x="390" y="28" text-anchor="middle">Agent C</text>
      <text class="research-difficulty-diagram__note" x="390" y="48" text-anchor="middle">Belief C</text>

      <path class="research-difficulty-diagram__path" d="M 90 58 V 82" marker-end="url(#heterogeneous-arrow)" />
      <path class="research-difficulty-diagram__path" d="M 240 58 V 82" marker-end="url(#heterogeneous-arrow)" />
      <path class="research-difficulty-diagram__path" d="M 390 58 V 82" marker-end="url(#heterogeneous-arrow)" />
      <text class="research-difficulty-diagram__response" x="90" y="105" text-anchor="middle">Response A</text>
      <text class="research-difficulty-diagram__response" x="240" y="105" text-anchor="middle">Response B</text>
      <text class="research-difficulty-diagram__response" x="390" y="105" text-anchor="middle">Response C</text>

      <path class="research-difficulty-diagram__path" d="M 90 116 L 220 168" marker-end="url(#heterogeneous-arrow)" />
      <path class="research-difficulty-diagram__path" d="M 240 116 V 168" marker-end="url(#heterogeneous-arrow)" />
      <path class="research-difficulty-diagram__path" d="M 390 116 L 260 168" marker-end="url(#heterogeneous-arrow)" />
      <text class="research-difficulty-diagram__outcome" x="240" y="204" text-anchor="middle">Population Dynamics</text>
    </svg>
  </figure>
)}

{type === "observations" && (
  <figure class="research-difficulty-diagram">
    <svg
      viewBox="0 0 480 230"
      role="img"
      aria-labelledby="limited-observations-title limited-observations-description"
    >
      <title id="limited-observations-title">Limited and local observations</title>
      <desc id="limited-observations-description">
        Population-level information is not directly available to an agent, who instead uses local
        observations to infer decision-relevant information.
      </desc>
      <defs>
        <marker id="observations-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
          <path d="M 0 0 L 7 4 L 0 8 z" class="research-difficulty-diagram__arrowhead" />
        </marker>
      </defs>
      <text class="research-difficulty-diagram__label" x="240" y="28" text-anchor="middle">Population-level information</text>
      <path class="research-difficulty-diagram__dashed-path" d="M 240 38 V 58" />
      <text class="research-difficulty-diagram__note" x="240" y="76" text-anchor="middle">not directly observed</text>

      <text class="research-difficulty-diagram__label" x="240" y="106" text-anchor="middle">Local observations</text>
      <path class="research-difficulty-diagram__trajectory-line" d="M 92 124 C 138 100, 178 142, 222 120 S 310 100, 388 124" />
      <path class="research-difficulty-diagram__path" d="M 240 132 V 158" marker-end="url(#observations-arrow)" />
      <text class="research-difficulty-diagram__label" x="240" y="181" text-anchor="middle">Inference / Estimation</text>
      <path class="research-difficulty-diagram__path" d="M 240 188 V 204" marker-end="url(#observations-arrow)" />
      <text class="research-difficulty-diagram__outcome" x="240" y="222" text-anchor="middle">Decision-relevant information</text>
    </svg>
  </figure>
)}

{type === "strategic-beliefs" && (
  <figure class="research-difficulty-diagram research-difficulty-diagram--strategic-beliefs">
    <svg
      viewBox="0 0 480 230"
      role="img"
      aria-labelledby="strategic-beliefs-title strategic-beliefs-description"
    >
      <title id="strategic-beliefs-title">Asymmetric information and strategic beliefs</title>
      <desc id="strategic-beliefs-description">
        Another agent's hidden belief shapes a strategy and observable behavior. An observer can
        use that behavior to infer the belief or likely strategy, while a private update can change
        the hidden belief.
      </desc>
      <defs>
        <marker id="strategic-beliefs-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
          <path d="M 0 0 L 7 4 L 0 8 z" class="research-difficulty-diagram__arrowhead" />
        </marker>
        <marker id="strategic-beliefs-private-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
          <path d="M 0 0 L 7 4 L 0 8 z" class="research-difficulty-diagram__private-arrowhead" />
        </marker>
      </defs>

      <text class="research-difficulty-diagram__label" x="110" y="28" text-anchor="middle">Other Agent's Belief</text>
      <text class="research-difficulty-diagram__note" x="110" y="48" text-anchor="middle">(hidden)</text>
      <path class="research-difficulty-diagram__path" d="M 110 58 V 70" marker-end="url(#strategic-beliefs-arrow)" />
      <text class="research-difficulty-diagram__label" x="110" y="92" text-anchor="middle">Strategy</text>
      <path class="research-difficulty-diagram__path" d="M 110 102 V 112" marker-end="url(#strategic-beliefs-arrow)" />
      <text class="research-difficulty-diagram__label" x="110" y="134" text-anchor="middle">Observable Behavior</text>

      <path class="research-difficulty-diagram__path" d="M 176 130 H 330" marker-end="url(#strategic-beliefs-arrow)" />
      <text class="research-difficulty-diagram__label" x="380" y="134" text-anchor="middle">My Observation</text>
      <path class="research-difficulty-diagram__path" d="M 380 144 V 160" marker-end="url(#strategic-beliefs-arrow)" />
      <text class="research-difficulty-diagram__label" x="380" y="181" text-anchor="middle">Inference</text>
      <path class="research-difficulty-diagram__path" d="M 380 191 V 201" marker-end="url(#strategic-beliefs-arrow)" />
      <text class="research-difficulty-diagram__outcome" x="380" y="221" text-anchor="middle">Belief / likely strategy</text>

      <text class="research-difficulty-diagram__note" x="380" y="28" text-anchor="middle">Private update</text>
      <path class="research-difficulty-diagram__dashed-path" d="M 320 36 H 166" marker-end="url(#strategic-beliefs-private-arrow)" />
    </svg>
  </figure>
)}
