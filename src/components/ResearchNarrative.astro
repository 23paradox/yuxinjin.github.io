---
import type { ResearchNarrative } from "../data/site";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  narrative: ResearchNarrative;
}

const { narrative } = Astro.props;
---

<div class="research-narrative">
  <section class="page-section research-narrative__questions" aria-labelledby="research-questions-heading">
    <SectionHeading id="research-questions-heading" title="Research questions" />
    <ol class="research-question-list">
      {narrative.questions.map((item) => (
        <li class="research-question-list__item">
          <span class="research-question-list__number" aria-hidden="true">
            {item.number}
          </span>
          <h3>{item.question}</h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="page-section research-narrative__themes" aria-labelledby="research-themes-heading">
    <SectionHeading
      id="research-themes-heading"
      title="Mathematical themes"
    />
    <div class="research-theme-list">
      {narrative.mathematicalThemes.map((theme) => (
        <article class="research-theme-list__item">
          <h3>{theme.title}</h3>
          <p>{theme.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section research-narrative__directions" aria-labelledby="broader-directions-heading">
    <SectionHeading id="broader-directions-heading" title="Current directions" />
    <p class="research-direction-list__intro">{narrative.broaderDirections.broaderInterest}</p>
    <div class="research-direction-list">
      {narrative.broaderDirections.directions.map((direction) => (
        <article>
          <h3>{direction.title}</h3>
          <p>{direction.description}</p>
        </article>
      ))}
    </div>
  </section>
</div>
