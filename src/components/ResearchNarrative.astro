---
import type { ResearchNarrative } from "../data/site";
import {
  getPrimaryAcademicLink,
  type PublicationEntry,
} from "../lib/content";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  narrative: ResearchNarrative;
  publications: readonly PublicationEntry[];
}

const { narrative, publications } = Astro.props;
const publicationsById = new Map(
  publications.map((publication) => [publication.id, publication]),
);
const currentResearch = narrative.currentResearch.map((theme) => ({
  ...theme,
  relatedPublications: theme.relatedPublications.map((reference) => {
    const publication = publicationsById.get(reference.id);

    if (!publication) {
      throw new Error(
        `Research theme "${theme.title}" references missing publication "${reference.id}".`,
      );
    }

    const primaryLink = getPrimaryAcademicLink(publication);

    if (!primaryLink) {
      throw new Error(
        `Research theme "${theme.title}" references publication "${reference.id}" without a primary academic link.`,
      );
    }

    return {
      href: primaryLink.url,
      label: reference.label,
      title: publication.data.title,
    };
  }),
}));
---

<div class="research-narrative">
  <section class="page-section research-narrative__themes" aria-labelledby="current-research-heading">
    <SectionHeading
      id="current-research-heading"
      title="Current research"
    />
    <div class="research-theme-list">
      {currentResearch.map((theme) => (
        <article class="research-theme-list__item">
          <h3>{theme.title}</h3>
          <p>{theme.description}</p>
          <p
            class="research-theme-list__related"
            aria-label={`Related work for ${theme.title}`}
          >
            <span class="research-theme-list__related-label">Related work</span>
            {theme.relatedPublications.map((publication) => (
              <>
                <span aria-hidden="true"> · </span>
                <a
                  href={publication.href}
                  aria-label={`${publication.label} — ${publication.title}`}
                >
                  {publication.label} <span aria-hidden="true">↗</span>
                </a>
              </>
            ))}
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section research-narrative__directions" aria-labelledby="future-directions-heading">
    <SectionHeading id="future-directions-heading" title="Future directions" />
    <div class="research-direction-list">
      {narrative.futureDirections.map((direction) => (
        <article>
          <h3>{direction.title}</h3>
          <p>{direction.description}</p>
        </article>
      ))}
    </div>
  </section>
</div>
