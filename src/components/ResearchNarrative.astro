---
import type { ResearchNarrative } from "../data/site";
import type { PublicationEntry } from "../lib/content";
import ResearchDifficultyDiagram from "./ResearchDifficultyDiagram.astro";
import ResearchLoopDiagram from "./ResearchLoopDiagram.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  narrative: ResearchNarrative;
  publications: readonly PublicationEntry[];
}

const { narrative, publications } = Astro.props;

function getPublicPaperLink(publication: PublicationEntry): string | undefined {
  return publication.data.links?.find((link) =>
    ["paper", "preprint", "journal", "doi"].includes(link.purpose),
  )?.url;
}

const publicationsById = new Map(publications.map((publication) => [publication.id, publication]));

const milestones = narrative.milestones.map((milestone) => {
  const relatedWorks = milestone.publicationIds.map((publicationId) => {
    const publication = publicationsById.get(publicationId);

    if (!publication) {
      throw new Error(
        `Research narrative milestone references a missing publication: ${publicationId}`,
      );
    }

    const paperUrl = getPublicPaperLink(publication);

    if (!paperUrl) {
      throw new Error(
        `Research narrative milestone has no public paper link: ${publication.data.title}`,
      );
    }

    return { title: publication.data.title, url: paperUrl };
  });

  return { ...milestone, relatedWorks };
});

const difficultyDiagramTypes = [
  "heterogeneous",
  "observations",
  "strategic-beliefs",
] as const;
---

<div class="research-narrative">
  <section class="page-section research-narrative__loop-section" aria-labelledby="information-decision-loop-heading">
    <SectionHeading
      id="information-decision-loop-heading"
      title="The Information–Decision Loop"
    />
    <ResearchLoopDiagram steps={narrative.loop.steps} />
    <p class="research-loop__caption">{narrative.loop.caption}</p>
  </section>

  <section class="page-section research-narrative__questions" aria-labelledby="research-questions-heading">
    <SectionHeading id="research-questions-heading" title="Three Questions I Study" />
    <ol class="research-question-list">
      {narrative.questions.map((item) => (
        <li class="research-question-list__item">
          <span class="research-question-list__number" aria-hidden="true">
            {item.number}
          </span>
          <h3>{item.question}</h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="page-section research-narrative__difficulty" aria-labelledby="research-difficulty-heading">
    <SectionHeading
      id="research-difficulty-heading"
      title="Where the Difficulty Comes From"
    />
    <div class="research-difficulty-list">
      {narrative.difficultySettings.map((setting, index) => (
        <article class="research-difficulty-list__item">
          <ResearchDifficultyDiagram
            type={difficultyDiagramTypes[index] ?? "heterogeneous"}
          />
          <div class="research-difficulty-list__copy">
            <h3>{setting.title}</h3>
            <p>{setting.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="page-section" aria-labelledby="research-evolution-heading">
    <SectionHeading
      id="research-evolution-heading"
      title="How This Agenda Has Evolved"
    />
    <ol class="research-evolution-list">
      {milestones.map((milestone) => (
        <li class="research-evolution-list__item">
          <p class="research-evolution-list__year">{milestone.year}</p>
          <div class="research-evolution-list__body">
            <h3>{milestone.title}</h3>
            <p>{milestone.description}</p>
            <div class="research-evolution-list__related">
              <p class="research-evolution-list__related-label">Related work</p>
              <ul class="research-evolution-list__related-list">
                {milestone.relatedWorks.map((work) => (
                  <li>
                    <a href={work.url}>{work.title} <span aria-hidden="true">→</span></a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="page-section research-narrative__forward" aria-labelledby="looking-forward-heading">
    <SectionHeading id="looking-forward-heading" title="Looking Forward" />
    <p>{narrative.lookingForward}</p>
  </section>
</div>
