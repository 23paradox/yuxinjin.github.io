---
import PublicationList from "../components/PublicationList.astro";
import { placeholders } from "../data/placeholders";
import {
  loadPublications,
  sortPublicationsChronologically,
} from "../lib/content";
import { showDevelopmentPlaceholders } from "../lib/rendering";
import BaseLayout from "../layouts/BaseLayout.astro";

const publications = sortPublicationsChronologically(await loadPublications());
const researchPublications = publications.filter(
  (publication) => publication.data.authorship === "first-author",
);
const collaborativePublications = publications.filter(
  (publication) => publication.data.authorship === "collaborative",
);
---

<BaseLayout pageTitle="Publications">
  <header class="page-section page-intro">
    <h1>Publications</h1>
  </header>

  {(publications.length > 0 || showDevelopmentPlaceholders) && (
    <section class="page-section publications-page" aria-label="All publications">
      {publications.length > 0 ? (
        <>
          {researchPublications.length > 0 && (
            <section class="publications-page__group" aria-labelledby="research-papers-heading">
              <h2 id="research-papers-heading">Research Papers</h2>
              <PublicationList items={researchPublications} headingLevel="h3" />
            </section>
          )}
          {collaborativePublications.length > 0 && (
            <section class="publications-page__group" aria-labelledby="collaborative-work-heading">
              <h2 id="collaborative-work-heading">Collaborative Work</h2>
              <p class="publications-page__introduction">
                Computational work in these collaborations included project-specific LQ mean field game solver frameworks for the two LQ studies and adaptations of an existing GAN-based mean field game solver for the three nonlinear studies.
              </p>
              <PublicationList items={collaborativePublications} headingLevel="h3" />
            </section>
          )}
        </>
      ) : (
        <p data-placeholder>{placeholders.publications}</p>
      )}
    </section>
  )}
</BaseLayout>
