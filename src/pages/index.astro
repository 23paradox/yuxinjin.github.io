---
import SectionHeading from "../components/SectionHeading.astro";
import { Image } from "astro:assets";
import portrait from "../assets/images/portrait-venice.jpg";
import PublicationList from "../components/PublicationList.astro";
import RecognitionList from "../components/RecognitionList.astro";
import { placeholders } from "../data/placeholders";
import { siteData } from "../data/site";
import {
  getSelectedPublications,
  loadPublications,
} from "../lib/content";
import { withBase } from "../lib/paths";
import { getSelectedRecognition } from "../lib/profile";
import {
  developmentFallback,
  showDevelopmentPlaceholders,
} from "../lib/rendering";
import BaseLayout from "../layouts/BaseLayout.astro";

const publicationEntries = await loadPublications();
const selectedPublications = getSelectedPublications(publicationEntries);
const homepagePublicationIds = [
  "lq-mean-field-games-heterogeneous-erroneous-information",
  "initial-error-tolerant-distributed-mean-field-control",
  "major-minor-lq-mean-field-games-erroneous-initial-information",
];
const homepagePublications = homepagePublicationIds.flatMap((publicationId) => {
  const publication = selectedPublications.find(
    (entry) => entry.id === publicationId,
  );

  return publication ? [publication] : [];
});
const selectedRecognition = getSelectedRecognition(siteData.about.recognition);
const heroName = developmentFallback(siteData.profile.name, placeholders.name);
const heroIdentity = developmentFallback(
  siteData.profile.academicTitle,
  placeholders.academicTitle,
);
const institutionLabel = [siteData.profile.department, siteData.profile.institution]
  .filter(Boolean)
  .join(" · ");
const heroInstitution = developmentFallback(institutionLabel, placeholders.institution);
const heroSummary = developmentFallback(
  siteData.research.heroSummary,
  placeholders.researchAgenda,
);
const aboutTeaser = developmentFallback(
  siteData.about.biography.teaser,
  placeholders.personalIntroduction,
);

---

<BaseLayout isHomepage>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__copy">
      <h1 id="hero-heading" class="hero__name">
        {heroName}
      </h1>
      {heroIdentity && (
        <p
          class="hero__identity"
          data-placeholder={!siteData.profile.academicTitle || undefined}
        >
          {heroIdentity}
        </p>
      )}
      {heroInstitution && (
        <p
          class="hero__institution"
          data-placeholder={!institutionLabel || undefined}
        >
          {heroInstitution}
        </p>
      )}
      {siteData.profile.currentStatus && (
        <p class="hero__affiliation">{siteData.profile.currentStatus}</p>
      )}

      <h2 class="hero__research-title">{siteData.profile.researchIdentity}</h2>

      {heroSummary && (
        <p
          class="hero__summary"
          data-placeholder={!siteData.research.heroSummary || undefined}
        >
          {heroSummary}
        </p>
      )}

      {siteData.research.keywords.length > 0 && (
        <p class="hero__keywords">
          {siteData.research.keywords.join(" · ")}
        </p>
      )}

      <nav class="hero__links" aria-label="Academic links">
        <span class="hero__link-group hero__link-group--primary">
          <a class="hero__link--primary" href={withBase("/research/")}>Research</a>
          <a class="hero__link--primary" href={withBase("/publications/")}>Publications</a>
        </span>
        <span class="hero__link-group hero__link-group--secondary">
          {siteData.profile.googleScholarUrl && (
            <a class="hero__link--secondary" href={siteData.profile.googleScholarUrl}>
              Google Scholar <span aria-hidden="true">↗</span>
            </a>
          )}
          {siteData.profile.researchGateUrl && (
            <a class="hero__link--secondary" href={siteData.profile.researchGateUrl}>
              ResearchGate <span aria-hidden="true">↗</span>
            </a>
          )}
          {siteData.profile.email && (
            <a class="hero__link--secondary" href={`mailto:${siteData.profile.email}`}>
              Email <span aria-hidden="true">↗</span>
            </a>
          )}
        </span>
      </nav>
    </div>

    <figure class="hero__portrait">
      <Image
        class="hero__portrait-image"
        src={portrait}
        alt="Portrait of Yuxin Jin"
        width={720}
        format="webp"
        quality={85}
        priority
      />
    </figure>
  </section>

  <section class="page-section home-section home-section--research" aria-labelledby="research-heading">
    <SectionHeading id="research-heading" number="01" title="Research" />
    <p class="home-research-hook">{siteData.research.homeHook}</p>
    <p class="home-research-flow" aria-label="Research flow: misspecification, inference, revision">
      <span>misspecification</span>
      <span aria-hidden="true">→</span>
      <span>inference</span>
      <span aria-hidden="true">→</span>
      <span>revision</span>
    </p>
    <div class="home-research-questions">
      {siteData.research.homeQuestions.map((question) => (
        <article class="home-research-question">
          <h3>{question.title}</h3>
          <p>{question.description}</p>
        </article>
      ))}
    </div>
    <a class="text-link" href={withBase("/research/")}>Explore my research →</a>
  </section>

  {(homepagePublications.length > 0 || showDevelopmentPlaceholders) && (
    <section class="page-section home-section home-section--work" aria-labelledby="selected-work-heading">
      <SectionHeading
        id="selected-work-heading"
        number="02"
        title="Selected Work"
      />
      {homepagePublications.length > 0 ? (
        <>
          <PublicationList items={homepagePublications} />
          <a class="text-link" href={withBase("/publications/")}>View all publications →</a>
        </>
      ) : (
        <p data-placeholder>{placeholders.publications}</p>
      )}
    </section>
  )}

  {((selectedRecognition.length > 0 || showDevelopmentPlaceholders) ||
    (aboutTeaser || showDevelopmentPlaceholders)) && (
    <div class="home-closing">
      {(selectedRecognition.length > 0 || showDevelopmentPlaceholders) && (
        <section class="page-section home-section home-section--recognition" aria-labelledby="recognition-heading">
          <SectionHeading id="recognition-heading" number="03" title="Recognition" />
          {selectedRecognition.length > 0 ? (
            <RecognitionList items={selectedRecognition} showDetails={false} />
          ) : (
            <p data-placeholder>{placeholders.recognition}</p>
          )}
        </section>
      )}

      {(aboutTeaser || showDevelopmentPlaceholders) && (
        <section class="page-section home-section about-teaser" aria-labelledby="about-teaser-heading">
          <SectionHeading id="about-teaser-heading" number="04" title="About" />
          {aboutTeaser && (
            <p data-placeholder={!siteData.about.biography.teaser || undefined}>
              {aboutTeaser}
            </p>
          )}
          <a class="text-link" href={withBase("/about/")}>More about me →</a>
        </section>
      )}
    </div>
  )}
</BaseLayout>
