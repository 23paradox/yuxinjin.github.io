---
import ResearchNarrative from "../components/ResearchNarrative.astro";
import { siteData } from "../data/site";
import { loadPublications } from "../lib/content";
import BaseLayout from "../layouts/BaseLayout.astro";

const publications = await loadPublications();
---

<BaseLayout pageTitle="Research">
  <header class="page-section page-intro">
    <h1>Research</h1>
    <p class="research-page__subtitle">{siteData.research.narrative.subtitle}</p>
    <p class="research-page__opening-question">
      {siteData.research.narrative.openingQuestion}
    </p>
    <p class="research-page__opening">{siteData.research.narrative.opening}</p>
  </header>

  <ResearchNarrative
    narrative={siteData.research.narrative}
    publications={publications}
  />

</BaseLayout>
