---
import ResearchNarrative from "../components/ResearchNarrative.astro";
import { siteData } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout pageTitle="Research">
  <header class="page-section research-hero">
    <div class="research-hero__heading">
      <h1>Research</h1>
      <p class="research-page__subtitle">{siteData.research.narrative.subtitle}</p>
    </div>
    <div class="research-hero__copy">
      <p class="research-page__lead">{siteData.research.narrative.leadStatement}</p>
      <p class="research-page__supporting">
        {siteData.research.narrative.supportingParagraph}
      </p>
    </div>
  </header>

  <ResearchNarrative narrative={siteData.research.narrative} />

</BaseLayout>
