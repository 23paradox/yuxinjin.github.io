---
import ResearchNarrative from "../components/ResearchNarrative.astro";
import ResearchLoopDiagram from "../components/ResearchLoopDiagram.astro";
import { siteData } from "../data/site";
import { loadPublications } from "../lib/content";
import BaseLayout from "../layouts/BaseLayout.astro";

const publications = await loadPublications();
---

<BaseLayout pageTitle="Research">
  <header class="page-section research-hero">
    <div class="research-hero__copy">
      <h1>Research</h1>
      <p class="research-page__subtitle">{siteData.research.narrative.subtitle}</p>
      <p class="research-page__lead">{siteData.research.narrative.leadStatement}</p>
      <p class="research-page__supporting">
        {siteData.research.narrative.supportingParagraph}
      </p>
    </div>
    <ResearchLoopDiagram
      steps={siteData.research.narrative.loop.steps}
      caption={siteData.research.narrative.loop.caption}
    />
  </header>

  <ResearchNarrative
    narrative={siteData.research.narrative}
    publications={publications}
  />

</BaseLayout>
